  "cases": [
    {
      "name": "a claim that never arrives resolves as honest",
      "steps": [
        {
          "event": {
            "type": "action_selected",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "SELECT",
            "sender": 0,
            "payload": {
              "actor_id": "gambler",
              "move_id": "light_attack",
              "target_id": "gambler"
            }
          }
        },
        {
          "event": {
            "type": "commit_submitted",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "COMMIT",
            "sender": 0,
            "payload": {
              "roll_commit": "a",
              "observer_secret": "b"
            }
          }
        },
        {
          "event": {
            "type": "commit_submitted",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "COMMIT",
            "sender": 1,
            "payload": {
              "roll_commit": "a",
              "observer_secret": "b"
            }
          }
        },
        {
          "event": {
            "type": "claim_submitted",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "CLAIM",
            "sender": 0,
            "payload": {
              "value": 18
            }
          }
        },
        {
          "event": {
            "type": "phase_timeout",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "CLAIM",
            "sender": -1,
            "payload": {
              "timed_out_sender": 1
            }
          }
        },
        {
          "event": {
            "type": "challenge_submitted",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "CHALLENGE",
            "sender": 0,
            "payload": {
              "challenge": false
            }
          }
        },
        {
          "event": {
            "type": "challenge_submitted",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "CHALLENGE",
            "sender": 1,
            "payload": {
              "challenge": false
            }
          }
        },
        {
          "event": {
            "type": "reveal_submitted",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "REVEAL",
            "sender": 0,
            "payload": {
              "secret": "a"
            }
          }
        },
        {
          "event": {
            "type": "reveal_submitted",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "REVEAL",
            "sender": 1,
            "payload": {
              "secret": "a"
            }
          }
        },
        {
          "event": {
            "type": "exchange_resolved",
            "match_id": "c4-timeouts",
            "exchange_number": 1,
            "phase": "RESOLVE",
            "sender": -1,
            "payload": {
              "true_rolls": [
                18,
                12
              ]
            }
          }
        }
      ],
      "assertions": [
        {
          "path": "last_resolution.defence.claim",
          "equals": 12
        },
        {
          "path": "last_resolution.defence.padding",
          "equals": 0
        },
        {
          "path": "last_resolution.defence.outcome",
          "equals": "HONEST_PASS"
        },
        {
          "path": "exchange_number",
          "equals": 2
        }
      ]
    },
