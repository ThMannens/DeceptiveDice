{
  "name": "A5 correct challenges that win nothing",
  "initial_state": {
    "match_id": "a5-caught",
    "player_ids": ["alice", "bob"]
  },
  "setup_steps": [
    {"event": {"type": "draft_submitted", "match_id": "a5-caught", "exchange_number": 0, "phase": "DRAFT", "sender": 0, "payload": {"character_ids": ["wizard", "knight", "bard", "rogue"]}}},
    {"event": {"type": "draft_submitted", "match_id": "a5-caught", "exchange_number": 0, "phase": "DRAFT", "sender": 1, "payload": {"character_ids": ["scribe", "knight", "bard", "rogue"]}}},
    {"event": {"type": "formation_submitted", "match_id": "a5-caught", "exchange_number": 0, "phase": "PLACEMENT", "sender": 0, "payload": {"character_ids": ["wizard", "bard", "rogue", "knight"]}}},
    {"event": {"type": "formation_submitted", "match_id": "a5-caught", "exchange_number": 0, "phase": "PLACEMENT", "sender": 1, "payload": {"character_ids": ["scribe", "bard", "rogue", "knight"]}}}
  ],
  "cases": [
    {
      "name": "catching a padded defence exposes the defender when the attack still deals nothing",
      "steps": [
        {"event": {"type": "action_selected", "match_id": "a5-caught", "exchange_number": 1, "phase": "SELECT", "sender": 0, "payload": {"actor_id": "bard", "move_id": "light_attack", "target_id": "bard"}}},
        {"event": {"type": "commit_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "COMMIT", "sender": 0, "payload": {"roll_commit": "a", "observer_secret": "b"}}},
        {"event": {"type": "commit_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "COMMIT", "sender": 1, "payload": {"roll_commit": "a", "observer_secret": "b"}}},
        {"event": {"type": "claim_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "CLAIM", "sender": 0, "payload": {"value": 3}}},
        {"event": {"type": "claim_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "CLAIM", "sender": 1, "payload": {"value": 18}}},
        {"event": {"type": "challenge_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "CHALLENGE", "sender": 0, "payload": {"challenge": true}}},
        {"event": {"type": "challenge_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "CHALLENGE", "sender": 1, "payload": {"challenge": false}}},
        {"event": {"type": "reveal_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "REVEAL", "sender": 0, "payload": {"secret": "a"}}},
        {"event": {"type": "reveal_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "REVEAL", "sender": 1, "payload": {"secret": "a"}}},
        {"event": {"type": "exchange_resolved", "match_id": "a5-caught", "exchange_number": 1, "phase": "RESOLVE", "sender": -1, "payload": {"true_rolls": [3, 10]}}}
      ],
      "assertions": [
        {"path": "last_resolution.defence.outcome", "equals": "CAUGHT"},
        {"path": "last_resolution.hit", "equals": false},
        {"path": "last_resolution.hit_damage", "equals": 0},
        {"path": "teams.1.characters.2.effect_counters.exposed_after_wrong_call", "equals": true}
      ]
    },
    {
      "name": "a caught defence that let the attack through does not also expose",
      "steps": [
        {"event": {"type": "action_selected", "match_id": "a5-caught", "exchange_number": 1, "phase": "SELECT", "sender": 0, "payload": {"actor_id": "bard", "move_id": "light_attack", "target_id": "bard"}}},
        {"event": {"type": "commit_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "COMMIT", "sender": 0, "payload": {"roll_commit": "a", "observer_secret": "b"}}},
        {"event": {"type": "commit_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "COMMIT", "sender": 1, "payload": {"roll_commit": "a", "observer_secret": "b"}}},
        {"event": {"type": "claim_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "CLAIM", "sender": 0, "payload": {"value": 14}}},
        {"event": {"type": "claim_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "CLAIM", "sender": 1, "payload": {"value": 18}}},
        {"event": {"type": "challenge_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "CHALLENGE", "sender": 0, "payload": {"challenge": true}}},
        {"event": {"type": "challenge_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "CHALLENGE", "sender": 1, "payload": {"challenge": false}}},
        {"event": {"type": "reveal_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "REVEAL", "sender": 0, "payload": {"secret": "a"}}},
        {"event": {"type": "reveal_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "REVEAL", "sender": 1, "payload": {"secret": "a"}}},
        {"event": {"type": "exchange_resolved", "match_id": "a5-caught", "exchange_number": 1, "phase": "RESOLVE", "sender": -1, "payload": {"true_rolls": [14, 5]}}}
      ],
      "assertions": [
        {"path": "last_resolution.defence.outcome", "equals": "CAUGHT"},
        {"path": "last_resolution.hit", "equals": true},
        {"path": "last_resolution.defender_self_damage", "equals": 26}
      ]
    },
    {
      "name": "a kit may still wipe the padding damage, and the exposure is what remains",
      "steps": [
        {"event": {"type": "action_selected", "match_id": "a5-caught", "exchange_number": 1, "phase": "SELECT", "sender": 0, "payload": {"actor_id": "bard", "move_id": "light_attack", "target_id": "knight"}}},
        {"event": {"type": "commit_submitted", "match_id": "a5-caught", "exchange_number": 1, "phase": "COMMIT", "sender": 0, "payload": {"roll_commit": "a", "observer_secret": "b"}}},
